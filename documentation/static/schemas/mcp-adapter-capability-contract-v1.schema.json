{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goose.ai/schemas/mcp-adapter-capability-contract-v1.schema.json",
  "title": "Untrusted MCP adapter capability contract v1",
  "description": "Structural prefilter for an untrusted, non-executable adapter capability contract. A schema match grants no trust or authorization and does not permit installation, download, or execution; JSON Schema cannot inspect duplicate lexical JSON keys, and consumers must use the fail-closed Rust parser before relying on this document.",
  "type": "object", "additionalProperties": false,
  "required": ["document_type", "schema_version", "capability_id", "contract_version", "contract_digest", "supported_manifest_schema_versions", "operations", "entrypoint_kinds", "transport_protocols", "platform_requirements", "permission_kinds", "config_kinds", "dependency_resolution", "trusted_launcher", "recovery"],
  "properties": {
    "document_type": {"const": "goose.mcp.adapter-capability-contract"}, "schema_version": {"const": 1}, "capability_id": {"$ref": "#/$defs/id"}, "contract_version": {"$ref": "#/$defs/semver_version"}, "contract_digest": {"$ref": "#/$defs/digest"}, "supported_manifest_schema_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4294967295}}, "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/operation"}, "description": "uniqueItems compares complete JSON values only; the Rust parser also requires operation.id to be unique."}, "entrypoint_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "transport_protocols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/transport"}, "description": "uniqueItems compares complete JSON values only; the Rust parser also requires each transport/protocol_range pair to be unique."}, "platform_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/platform"}, "description": "uniqueItems compares complete JSON values only; the Rust parser requires selector to be unique and validates selector/runtime pairs."}, "permission_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "config_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "dependency_resolution": {"const": "closed_lock_only"}, "trusted_launcher": {"$ref": "#/$defs/launcher"}, "recovery": {"$ref": "#/$defs/recovery"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semver_version": {"type": "string", "minLength": 5, "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "semver_range": {"type": "string", "minLength": 1, "maxLength": 128, "description": "The Rust parser validates the complete semver::VersionReq grammar, including numeric bounds and comparator count; Draft JSON Schema is not the authoritative range parser."},
    "operation": {"type": "object", "additionalProperties": false, "required": ["id", "request_kind", "response_kind"], "properties": {"id": {"$ref": "#/$defs/id"}, "request_kind": {"$ref": "#/$defs/id"}, "response_kind": {"$ref": "#/$defs/id"}}},
    "transport": {"type": "object", "additionalProperties": false, "required": ["transport", "protocol_range"], "properties": {"transport": {"$ref": "#/$defs/id"}, "protocol_range": {"$ref": "#/$defs/semver_range"}}},
    "platform": {"type": "object", "additionalProperties": false, "required": ["selector", "runtime"], "properties": {"selector": {"$ref": "#/$defs/id"}, "runtime": {"$ref": "#/$defs/id"}}},
    "launcher": {"type": "object", "additionalProperties": false, "required": ["identity", "digest"], "properties": {"identity": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["rollback_supported", "maximum_attempts"], "properties": {"rollback_supported": {"type": "boolean"}, "maximum_attempts": {"type": "integer", "minimum": 1, "maximum": 4294967295}}}
  }
}
