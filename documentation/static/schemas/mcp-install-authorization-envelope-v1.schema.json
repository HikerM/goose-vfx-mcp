{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hikerm.github.io/lumina/schemas/mcp-install-authorization-envelope-v1.schema.json",
  "title": "Unverified MCP install authorization envelope v1",
  "description": "Structural prefilter for an unverified authorization envelope. A schema match does not verify a signature, grant authorization, or permit installation, download, or execution; JSON Schema cannot inspect duplicate lexical JSON keys, and consumers must use the fail-closed Rust parser before relying on this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "schema_version", "authorization_id", "issuer", "tenant", "manifest_digest", "closure_digest", "artifact_bindings", "adapter_contract", "platform", "mode", "issued_at_ms", "not_before_ms", "expires_at_ms", "revocation", "offline", "signature"],
  "properties": {
    "document_type": {"const": "lumina.mcp.install-authorization"}, "schema_version": {"const": 1}, "authorization_id": {"$ref": "#/$defs/id"}, "issuer": {"$ref": "#/$defs/id"}, "tenant": {"$ref": "#/$defs/id"}, "manifest_digest": {"$ref": "#/$defs/digest"}, "closure_digest": {"$ref": "#/$defs/digest"},
    "artifact_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}, "description": "uniqueItems compares complete JSON values only; the Rust parser also requires artifact_id to be unique."}, "adapter_contract": {"$ref": "#/$defs/contract"}, "platform": {"$ref": "#/$defs/id"}, "mode": {"enum": ["offline_bound", "online_bound"]}, "issued_at_ms": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615, "description": "The Rust parser enforces issued_at_ms <= not_before_ms <= expires_at_ms."}, "not_before_ms": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615, "description": "The Rust parser enforces issued_at_ms <= not_before_ms <= expires_at_ms."}, "expires_at_ms": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615, "description": "The Rust parser enforces issued_at_ms <= not_before_ms <= expires_at_ms."}, "revocation": {"$ref": "#/$defs/revocation"}, "offline": {"$ref": "#/$defs/offline"}, "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semver_version": {"type": "string", "minLength": 5, "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "sha256", "length_bytes"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/digest"}, "length_bytes": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/semver_version"}, "digest": {"$ref": "#/$defs/digest"}}},
    "revocation": {"type": "object", "additionalProperties": false, "required": ["reference_digest", "checked_at_ms"], "properties": {"reference_digest": {"$ref": "#/$defs/digest"}, "checked_at_ms": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}}},
    "offline": {"type": "object", "additionalProperties": false, "required": ["allowed", "maximum_age_ms"], "properties": {"allowed": {"type": "boolean"}, "maximum_age_ms": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "signature_digest"], "properties": {"algorithm": {"$ref": "#/$defs/id"}, "key_id": {"$ref": "#/$defs/id"}, "signature_digest": {"$ref": "#/$defs/digest"}}}
  }
}
