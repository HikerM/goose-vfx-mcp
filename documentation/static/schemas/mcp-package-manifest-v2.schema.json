{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hikerm.github.io/lumina/schemas/mcp-package-manifest-v2.schema.json",
  "title": "lumina MCP Package Manifest v2 runtime contract",
  "description": "Unplanned runtime metadata contract. It does not authorize installation or bootstrap.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "runtime", "lock"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "platform", "architecture", "abi", "sha256", "length_bytes", "immutable_origin_id", "provenance_digest"],
      "properties": {
        "family": { "enum": ["node", "python"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 64 },
        "abi": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "length_bytes": { "type": "integer", "minimum": 1 },
        "immutable_origin_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provenance_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_identity", "catalog_digest", "expires_at_ms", "revocation_digest", "root_key_ids", "root_threshold"],
      "properties": {
        "catalog_identity": { "type": "string", "minLength": 1, "maxLength": 128 },
        "catalog_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expires_at_ms": { "type": "integer", "minimum": 1 },
        "revocation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "root_key_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "root_threshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
